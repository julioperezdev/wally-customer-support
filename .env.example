# Copy to .env locally. Values here are safe local placeholders only.
# Never commit .env or paste real credentials into Jira, logs or documentation.
POSTGRES_DB=wcs
POSTGRES_USER=wcs
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=jdbc:postgresql://localhost:5432/wcs
DATABASE_USERNAME=wcs
DATABASE_PASSWORD=change-me-local-only

WCS_WHATSAPP_ADAPTER=mock
WCS_LLM_PROVIDER=mock
WCS_LLM_MODEL=llm.mock.v1
WCS_RAG_PROVIDER=mock

WHATSAPP_GRAPH_API_VERSION=v25.0
