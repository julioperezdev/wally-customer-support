META_APP_SECRET=
WCS_ALLOWED_RECIPIENT=
WCS_WHATSAPP_CONNECT_TIMEOUT=PT2S
WCS_WHATSAPP_READ_TIMEOUT=PT5S
WCS_OUTBOX_MAX_ATTEMPTS=3
SERVER_PORT=8080
