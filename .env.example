# Copy to .env locally and fill only with newly issued test credentials.
# Never commit .env or paste real values into Jira, logs or documentation.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
POC_ALLOWED_RECIPIENT=
POC_FIXED_REPLY=Respuesta de prueba de WCS.
POC_REPLY_MODE=text
POC_TEMPLATE_NAME=
POC_TEMPLATE_LANGUAGE_CODE=en_US
# Optional body text parameters separated by |, in the exact order required by Meta.
POC_TEMPLATE_BODY_PARAMETERS=
POC_CONNECT_TIMEOUT=2s
POC_READ_TIMEOUT=5s
SERVER_PORT=8080
