# Local-only configuration for Grafana. Copy to .env and adjust if needed.
# Never commit .env or put AWS access keys in this file.
AWS_PROFILE=julio_dev
AWS_REGION=us-east-1
# Required for access from a phone through the computer's VPN interface.
# Restrict this port with the host firewall to the VPN subnet.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Optional when the AWS config is not in the default host location.
# GRAFANA_AWS_CONFIG_DIR=/Users/julio/.aws
